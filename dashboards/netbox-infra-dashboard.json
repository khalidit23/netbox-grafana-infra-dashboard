      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT c.name AS cluster, d.name AS node, v.name AS vm, COALESCE(host(pip.address),\n  (SELECT host(a.address) FROM virtualization_vminterface vi\n   JOIN ipam_ipaddress a ON a.assigned_object_id = vi.id\n    AND a.assigned_object_type_id = (SELECT id FROM django_content_type WHERE app_label = 'virtualization' AND model = 'vminterface')\n   WHERE vi.virtual_machine_id = v.id ORDER BY a.id LIMIT 1),\n  'no IP') AS ip\nFROM virtualization_virtualmachine v\nLEFT JOIN dcim_device d ON d.id = v.device_id\nLEFT JOIN virtualization_cluster c ON c.id = v.cluster_id\nLEFT JOIN ipam_ipaddress pip ON pip.id = v.primary_ip4_id\nORDER BY 1, 2, 3"
        }
