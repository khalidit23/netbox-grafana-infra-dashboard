    {
      "id": 5,
      "type": "marcusolsson-dynamictext-panel",
      "title": "Cluster > Node > VM (with IP)",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 24
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${ds}"
      },
      "options": {
        "renderMode": "allRows",
        "wrap": true,
        "content": "<div class=\"infra\">{{{data.[0].html}}}</div>",
        "styles": "\n.infra{display:flex;flex-wrap:wrap;gap:20px;padding:6px;font-family:Inter,Helvetica,Arial,sans-serif}\n.cluster{flex:1 1 460px;background:linear-gradient(160deg,rgba(255,152,48,.16),rgba(255,152,48,.03));border:2px solid #FF9830;border-radius:18px;padding:14px;box-shadow:0 0 22px rgba(255,152,48,.28)}\n.cl-h{display:flex;align-items:center;gap:10px;font-size:22px;font-weight:800;letter-spacing:1px;color:#FFB45E;margin-bottom:14px;text-transform:uppercase}\n.nodes{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px}\n.node{background:linear-gradient(160deg,rgba(0,229,255,.14),rgba(0,229,255,.03));border:1.5px solid #00E5FF;border-radius:14px;padding:10px;box-shadow:0 0 14px rgba(0,229,255,.25)}\n.node-h{display:flex;align-items:center;gap:8px;color:#00E5FF;font-size:16px;margin-bottom:8px}\n.cnt{margin-left:auto;background:#00E5FF;color:#02202a;border-radius:12px;padding:1px 9px;font-size:11px;font-weight:800}\n.vm{display:flex;align-items:center;gap:8px;background:rgba(115,255,77,.10);border-left:4px solid #73FF4D;border-radius:8px;padding:5px 9px;margin-top:6px;font-size:13px}\n.vn{color:#E6FFD9;font-weight:700}\n.ip{margin-left:auto;color:#FFE066;font-family:Consolas,Menlo,monospace;font-size:12px}\n.ic{font-size:20px;line-height:1}\n.empty{color:#8b949e;font-size:12px;padding:4px}\n"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "WITH vm_ip AS (\n  SELECT v.id, v.name, v.device_id, COALESCE(host(pip.address),\n  (SELECT host(a.address) FROM virtualization_vminterface vi\n   JOIN ipam_ipaddress a ON a.assigned_object_id = vi.id\n    AND a.assigned_object_type_id = (SELECT id FROM django_content_type WHERE app_label = 'virtualization' AND model = 'vminterface')\n   WHERE vi.virtual_machine_id = v.id ORDER BY a.id LIMIT 1),\n  'no IP') AS ip\n  FROM virtualization_virtualmachine v\n  LEFT JOIN ipam_ipaddress pip ON pip.id = v.primary_ip4_id\n),\nnode_html AS (\n  SELECT d.cluster_id, d.name,\n    '<div class=\"node\"><div class=\"node-h\"><span class=\"ic\">🖥️</span><b>' || d.name || '</b><span class=\"cnt\">' || COUNT(x.id) || ' VM</span></div>'\n    || COALESCE(string_agg('<div class=\"vm\"><span class=\"ic\">💻</span><span class=\"vn\">' || x.name || '</span><span class=\"ip\">' || x.ip || '</span></div>', '' ORDER BY x.name), '<div class=\"empty\">No VM</div>')\n    || '</div>' AS html\n  FROM dcim_device d LEFT JOIN vm_ip x ON x.device_id = d.id\n  WHERE d.cluster_id IS NOT NULL\n  GROUP BY d.id, d.cluster_id, d.name\n),\ncluster_html AS (\n  SELECT c.name,\n    '<div class=\"cluster\"><div class=\"cl-h\"><span class=\"ic\">☁️</span>' || c.name || '</div><div class=\"nodes\">'\n    || COALESCE(string_agg(n.html, '' ORDER BY n.name), '') || '</div></div>' AS html\n  FROM virtualization_cluster c LEFT JOIN node_html n ON n.cluster_id = c.id\n  GROUP BY c.id, c.name\n)\nSELECT COALESCE(string_agg(html, '' ORDER BY name), '') AS html FROM cluster_html"
        }
      ]
    },
    {
