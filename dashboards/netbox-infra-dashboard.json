          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT s.name AS site, s.latitude::float AS latitude, s.longitude::float AS longitude, (SELECT COUNT(*) FROM dcim_device d WHERE d.site_id = s.id) AS servers, (SELECT COUNT(*) FROM virtualization_virtualmachine v WHERE v.site_id = s.id) AS vms FROM dcim_site s WHERE s.latitude IS NOT NULL"
