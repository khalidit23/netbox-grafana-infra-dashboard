          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT c.name AS cluster, COUNT(v.id) AS vms FROM virtualization_cluster c LEFT JOIN virtualization_virtualmachine v ON v.cluster_id = c.id GROUP BY c.name ORDER BY c.name"
